# ===== LLM 配置 =====
# 首选 DeepSeek；也可填任意 OpenAI 兼容 API 的 Key/BaseURL
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LLM_API_BASE=https://api.deepseek.com/v1
# true=无 Key 时启用规则模板兜底（保证全流程可演示）
LLM_FALLBACK_ENABLED=true

# ===== 情报平台 Key（可选，为空则该平台自动降级）=====
VT_API_KEY=
THREATBOOK_API_KEY=
FOFA_API_KEY=

# ===== 安全 =====
# 前端/API 简单 Token 鉴权（课设级）
API_TOKEN=dev-token
# 加密密钥文件路径（首次运行自动生成）
ENCRYPT_KEYFILE=keyfile
